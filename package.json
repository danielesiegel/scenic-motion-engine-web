    "@tweakpane/core": "^2.0.5",
    "@types/node": "^20.11.0",
    "@types/opentype.js": "^1.3.8",
    "playwright": "^1.47.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
